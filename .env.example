# GEMINI_API_KEY: Optional local Gemini calls (Image Studio / Coach fallbacks).
# Prefer backend AI via the API gateway in production.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (OAuth callbacks, self links).
APP_URL=""

# PEXELS_API_KEY: Optional — gaming stock imagery from Pexels.
PEXELS_API_KEY="Jrh6MyqmDwxyPpwZVA7Drxbxdt7Uuaki90Kos4O5WLSeJJoIk4cjyEQK"

# API GATEWAY CONFIGURATION
# Public/client-facing gateway endpoint (required for authenticated SPA calls).
# Production Cloud Run example:
# VITE_API_GATEWAY_URL="https://api-gateway-216098834386.us-central1.run.app"
VITE_API_GATEWAY_URL=""
VITE_API_GATEWAY_URL_STAGING="https://staging-api.nxclip.ai"
VITE_API_GATEWAY_URL_PRODUCTION="https://api-gateway-216098834386.us-central1.run.app"

# Socket.IO — notification-service Cloud Run origin (NOT api-gateway).
# Example: https://notification-service-xxxxx.us-central1.run.app
# Client connects to {VITE_NOTIFICATION_WS_URL}/events
# Leave empty when using local docker stack (defaults to http://localhost:5006/events).
VITE_NOTIFICATION_WS_URL=""

# Google Sign-In (same Web client ID as identity GOOGLE_OAUTH_CLIENT_ID).
# Optional when identity exposes GET /auth/google/config — preferred for Cloud Run.
VITE_GOOGLE_CLIENT_ID=""

# Secure internal service API Key for /internal/* service-to-service communication (dev only)
VITE_INTERNAL_API_KEY=""
