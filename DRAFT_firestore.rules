rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email.lower() in [
          "azhar.iqbal@thegamecompany.ai", 
          "aiqbal@visp.net", 
          "azheriqbal80@gmail.com", 
          "sidra.fahim@gmail.com"
        ] && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (data.plan in ['free', 'pro', 'studio', 'starter']) &&
             (data.role in ['user', 'admin', 'creator']);
    }

    function isValidCreation(data) {
      return data.uid == request.auth.uid &&
             data.type in ['image', 'meme', 'clip'] &&
             data.url is string && data.url.size() <= 2048 &&
             data.status in ['processing', 'published', 'rejected'] &&
             (data.prompt == null || (data.prompt is string && data.prompt.size() <= 3000)) &&
             (data.createdAt != null);
    }

    function isValidChatSession(data) {
      return data.uid == request.auth.uid &&
             data.messages is list && data.messages.size() <= 1000 &&
             data.updatedAt != null;
    }

    function isValidAnalyticsReport(data) {
      return data.uid is string &&
             data.weekEnding is string &&
             data.summary is string && data.summary.size() <= 20000;
    }

    // --- Collection Routes ---

    // Health check
    match /test/{docId} {
      allow get: if true;
    }

    // USERS
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isSignedIn(); // Semi-public for profiles
      allow list: if isSignedIn(); // Allow listing for search/feed
      
      allow create: if isOwner(uid) && 
                      isValidUserProfile(incoming()) && 
                      (incoming().role == 'user' || isAdmin());
      
      allow update: if (isOwner(uid) && (
        // Action: Profile Update
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'gameNiches', 'games', 'bio', 
          'audience', 'goal', 'frequency', 'startPoint', 'socials',
          'onboardingCompleted', 'coachQuestionsRemaining', 'contentPlan',
          'updatedAt', 'vibe', 'creatorName', 'tone', 'captionStyle', 'generationsLeft',
          'email', 'plan', 'role', 'uid', 'createdAt', 'platforms'
        ]) && 
        incoming().uid == existing().uid && 
        incoming().role == existing().role // Users cannot change their own role
      )) || isAdmin();

      allow delete: if isAdmin();
    }

    // CREATIONS
    match /creations/{creationId} {
      allow get, list: if isSignedIn();
      
      allow create: if isOwner(incoming().uid) && 
                      isValidCreation(incoming()) && 
                      isValidId(creationId);
      
      allow update: if (isOwner(existing().uid) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy', 'status', 'caption', 'hashtags', 'updatedAt'])
      )) || isAdmin();

      allow delete: if isOwner(existing().uid) || isAdmin();
    }

    // CHATS
    match /chats/{chatId} {
      allow get: if isOwner(existing().uid) || isAdmin();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create: if isOwner(incoming().uid) && 
                      isValidChatSession(incoming()) && 
                      isValidId(chatId);
      
      allow update: if isOwner(existing().uid) && (
                        incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt', 'title'])
                      );

      allow delete: if isOwner(existing().uid) || isAdmin();
    }

    // ANALYTICS
    match /analytics/{reportId} {
      allow get: if isOwner(existing().uid) || isAdmin();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      allow create, update, delete: if isAdmin();
    }

    // ADMINS
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
