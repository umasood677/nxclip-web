rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.get('email_verified', false) == true &&
             request.auth.token.get('email', '') in [
               "azhar.iqbal@thegamecompany.ai",
               "aiqbal@visp.net",
               "azheriqbal80@gmail.com",
               "sidra.fahim@gmail.com"
             ];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('plan' in data) || data.plan in ['free', 'pro', 'studio', 'starter']) &&
             (!('role' in data) || data.role in ['user', 'admin', 'creator']);
    }

    function isValidCreation(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('type' in data) || data.type in ['image', 'meme', 'clip']) &&
             (!('url' in data) || (data.url is string && data.url.size() <= 2048)) &&
             (!('status' in data) || data.status in ['processing', 'published', 'rejected']) &&
             (!('prompt' in data) || data.prompt == null || (data.prompt is string && data.prompt.size() <= 3000)) &&
             (!('createdAt' in data) || data.createdAt != null);
    }

    function isValidChatSession(data) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('messages' in data) || (data.messages is list && data.messages.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt != null);
    }

    function isValidAnalyticsReport(data) {
      return (!('uid' in data) || data.uid is string) &&
             (!('weekEnding' in data) || data.weekEnding is string) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 20000));
    }

    // --- Collection Routes ---

    // Health check
    match /test/{docId} {
      allow get: if true;
    }

    // USERS
    match /users/{uid} {
      allow get: if true; // Publicly readable profiles to avoid race conditions and allow public views
      allow list: if true; // Allow listing for search/feed
      
      allow create: if isOwner(uid) && 
                      isValidUserProfile(incoming()) && 
                      (!('role' in incoming()) || incoming().role == 'user' || isAdmin());
      
      allow update: if (isOwner(uid) && (
        // Action: Profile Update
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'gameNiches', 'games', 'bio', 
          'audience', 'goal', 'frequency', 'startPoint', 'socials',
          'onboardingCompleted', 'coachQuestionsRemaining', 'contentPlan',
          'updatedAt', 'vibe', 'creatorName', 'tone', 'captionStyle', 'generationsLeft',
          'email', 'plan', 'role', 'uid', 'createdAt', 'platforms'
        ]) && 
        (!('uid' in incoming()) || !('uid' in existing()) || incoming().uid == existing().uid) && 
        (!('role' in incoming()) || !('role' in existing()) || incoming().role == existing().role) // Users cannot change their own role
      )) || isAdmin();

      allow delete: if isAdmin();
    }

    // CREATIONS
    match /creations/{creationId} {
      allow get, list: if true; // Publicly viewable content creations
      
      allow create: if isOwner(incoming().uid) && 
                      isValidCreation(incoming()) && 
                      isValidId(creationId);
      
      allow update: if (request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy', 'status', 'caption', 'hashtags', 'updatedAt'])
      )) || isAdmin();

      allow delete: if (request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid)) || isAdmin();
    }

    // CHATS
    match /chats/{chatId} {
      allow get: if (request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid)) || isAdmin();
      allow list: if request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid);
      
      allow create: if isOwner(incoming().uid) && 
                      isValidChatSession(incoming()) && 
                      isValidId(chatId);
      
      allow update: if request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid) && (
                        incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt', 'title'])
                      );

      allow delete: if (request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid)) || isAdmin();
    }

    // ANALYTICS
    match /analytics/{reportId} {
      allow get: if (request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid)) || isAdmin();
      allow list: if request.auth != null && (resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid);
      
      allow create, update, delete: if isAdmin();
    }

    // ADMINS
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
