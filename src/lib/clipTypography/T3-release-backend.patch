+RUN python3 /opt/typography/validate_fonts.py
+
+FROM font-verification AS worker-font-verification
+COPY .tmp/typography-worker-build/apps/media-worker/src/render/application /worker-code
+COPY apps/media-worker/tools/verify-canonical-runtime.cjs /opt/verify-canonical-runtime.cjs
+RUN mkdir -p /app/assets/fonts/canonical && cp -a /output /app/assets/fonts/canonical/1.0.0 && node /opt/verify-canonical-runtime.cjs
+
+FROM scratch AS font-evidence
+COPY --from=worker-font-verification /output /
+
+FROM font-runtime AS production
 COPY --from=build /app/dist/apps/media-worker ./
 COPY --from=build /app/node_modules ./node_modules
 COPY --from=build /app/libs ./libs
 # OFL caption fonts for ASS burn-in (fontsdir)
 COPY --from=build /app/apps/media-worker/assets/fonts ./assets/fonts
+# Canonical faces are registered only for explicitly requested canonical renders.
 # Event Highlight transition SFX pack
 COPY --from=build /app/apps/media-worker/assets/sfx ./assets/sfx
 EXPOSE 8080
