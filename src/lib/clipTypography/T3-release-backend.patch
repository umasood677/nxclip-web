@@ -11,17 +11,38 @@ ENV CI=true
 RUN pnpm install --frozen-lockfile || pnpm install
 RUN pnpm nx build media-worker --skip-nx-cache
 
-FROM node:20-bookworm-slim AS production
+FROM node:20-bookworm-slim AS font-runtime
 WORKDIR /app
 ENV NODE_ENV=production
 RUN apt-get update \
   && apt-get install -y --no-install-recommends ffmpeg ca-certificates fontconfig \
   && rm -rf /var/lib/apt/lists/*
+FROM font-runtime AS font-validation
+# Validation-only tools; the production image retains its existing dependencies.
+RUN apt-get update && apt-get install -y --no-install-recommends python3-fonttools python3-brotli && rm -rf /var/lib/apt/lists/*
+COPY apps/media-worker/tools/typography /opt/typography
+ENTRYPOINT ["python3", "/opt/typography/validate_fonts.py"]
+
+FROM font-validation AS font-verification
+COPY --from=typography /public/fonts/clip-typography/1.0.0 /source/public/fonts/clip-typography/1.0.0
